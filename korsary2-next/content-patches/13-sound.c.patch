+// Existing game data has one-, two- and three-digit numbered locators.
+bool IsNumberedNightInsectsLocator(string locatorName)
+{
+	int n = strlen(locatorName);
+	if (n <= 12) return false;
+	if (strcut(locatorName, 0, 11) != "nightinsects") return false;
+	for (int j = 12; j < n; j++)
+	{
+		string digit = GetSymbol(&locatorName, j);
+		if (!isDigit(&digit, 0)) return false;
+	}
+	return true;
